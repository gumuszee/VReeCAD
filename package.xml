  <description>Intuitive parametric CAD modelling in virtual reality (OpenXR). Fork of the freecad-xr-workbench by Adrian Przekwas, reworked around simple, Blocks-inspired controller interaction.</description>

  <version>0.1.0</version>

  <date>2026-10-07</date>

  <maintainer email="vojtech.tuma@inventi.cz">Vojtech Tuma</maintainer>

  <author email="adrian.v.przekwas@gmail.com">Adrian Przekwas</author>

  <license file="LICENSE">LGPL-3.0-or-later</license>

  <pythonmin>3.11.0</pythonmin>

  <freecadmin>1.1.0</freecadmin>

  <url branch="main" type="repository">https://github.com/gumuszee/VReeCAD</url>

  <url type="bugtracker">https://github.com/gumuszee/VReeCAD/issues</url>

  <url type="readme">https://github.com/gumuszee/VReeCAD/blob/main/README.md</url>

  <icon>Resources/Gui/Resources/icons/preferences-virtual_reality.svg</icon>

  <content>
    <workbench>
      <name>VReeCAD</name>
      <description>Parametric CAD modelling in virtual reality: create, select, move, push and pull, edit points and sketch with controllers.</description>
      <icon>Resources/Gui/Resources/icons/preferences-virtual_reality.svg</icon>
      <classname>VReeCADWorkbench</classname>
      <subdirectory>./</subdirectory>
      <depend type="python">pyopenxr</depend>
      <depend type="python">PyOpenGL</depend>
    </workbench>
  </content>

</package>
